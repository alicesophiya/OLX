<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
  <LinearLayout
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/colorLightGrey"
    android:layout_height="wrap_content">
    
    
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_8">

        <ImageView
            android:id="@+id/imageViewLocation"
            android:layout_width="36dp"
            android:layout_height="87dp"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_4"
            android:src="@drawable/ic_location"></ImageView>
         <androidx.appcompat.widget.AppCompatTextView
             android:layout_width="wrap_content"
             android:id="@+id/tvCityName"
             android:layout_toEndOf="@+id/imageViewLocation"
             android:text="India"
             android:layout_centerVertical="true"
             android:layout_marginStart="@dimen/dp_4"
             android:textColor="@android:color/black"
             android:textAppearance="@style/TextAppearance.AppCompat.Medium"
             android:layout_height="wrap_content">

         </androidx.appcompat.widget.AppCompatTextView>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="87dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:padding="@dimen/dp_4"
            android:src="@drawable/ic_notifications_black_24dp"
            ></ImageView>


        
    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/box_black_bg_white"
        android:padding="@dimen/dp_6"
        android:layout_margin="@dimen/dp_16"
        android:orientation="horizontal">


    <ImageView
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:padding="@dimen/dp_4"
        android:src="@drawable/ic_search"></ImageView>

    <androidx.appcompat.widget.AppCompatEditText
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:id="@+id/edSearch"
        android:background="@null"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:hint="@string/find_cars">
    </androidx.appcompat.widget.AppCompatEditText>
        </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white" >


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:padding="@dimen/dp_8"
        android:textColor="@android:color/black"
        android:text="@string/browse_categories">

    </androidx.appcompat.widget.AppCompatTextView>
    
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_margin="@dimen/dp_8"
        android:id="@+id/rv_categories"
        android:layout_height="wrap_content"
        android:layout_gravity="center"

        >

    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>
</LinearLayout>
  </LinearLayout>
